@startuml two-module-new-forward-pass

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 20

actor Caller
participant "QmasPolicy" as P
participant "QmasActor" as A
participant "GNNBase / CNNBase\n/ MLPBase" as Base
participant "StateEncoder\n[if --state_encoder]" as SE
participant "RNNLayer\n[optional]" as RNN
participant "ACTLayer" as ACT
participant "QmasCritic" as C

== get_actions(cent_obs, obs, rnn_states_actor, rnn_states_critic, masks, global_obs) ==

Caller -> P : get_actions(...)
P -> A : forward(obs, rnn_states_actor, masks,\navailable_actions, deterministic, global_obs)

group Local encoder
  alt use_gnn
    A -> Base : GNNBase(graph.x, edge_attr, edge_index)
    Base --> A : node_feats  [B*N_nodes, H_gnn]
    note right of A
      to_dense_batch → [B, N_nodes, H_gnn]

      if gnn_neighbor_scoring:
        neighbor_scorer(feats) → scores [B, MAX_NEIGHBORS]
      elif agent_idx present:
        gatherNodeFeats(feats, agent_idx) → [B, H_gnn]
      else:
        graphAggr(feats, mean) → [B, H_gnn]

      cat with non-graph scalar obs → [B, H_gnn + D_scalar]
      [optional mlp0 → [B, hidden_size]]
    end note
  else use_cnn
    A -> Base : CNNBase(obs)
    Base --> A : feats  [B, hidden_size]
  else use_mlp
    A -> Base : MLPBase(obs)
    Base --> A : feats  [B, hidden_size]
  end
end

opt --state_encoder flag is set
  alt global_obs is None
    A -> A : encoded_state = zeros(B, state_encoder_output_dim)
  else
    A -> SE : forward(global_obs)
    SE --> A : encoded_state  [n_threads, state_encoder_output_dim]
    note right of A
      if encoded_state batch < actor batch:
        .repeat_interleave(n_agents, dim=0)
    end note
  end
  A -> A : actor_features = cat([feats, encoded_state], dim=-1)
end

opt --state_encoder not set AND uq_injection == "append"
  note over A
    obs was already doubled in shape at construction time
    (obs_shape[-1] * 2); no separate encoding step here
  end note
end

opt use_rnn
  A -> RNN : forward(actor_features, rnn_states, masks)
  RNN --> A : actor_features, rnn_states (updated)
end

A -> ACT : forward(actor_features, available_actions, deterministic)
ACT --> A : actions, action_log_probs
A --> P : actions, action_log_probs, rnn_states_actor

group Critic forward
  note over P
    if rnn_states_critic.shape[0] == cent_obs.shape[0] × n_agents:
      stride critic inputs by n_agents (one RNN state per env thread)
  end note
  P -> C : forward(cent_obs, rnn_states_critic[::n_agents], masks[::n_agents])
  C --> P : values, rnn_states_critic (updated)
  note over P : .repeat_interleave(n_agents) → restore per-agent shape
end

P --> Caller : values, actions, action_log_probs,\nrnn_states_actor, rnn_states_critic

@enduml
